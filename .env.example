# Local PostgreSQL database served by docker-compose.yml
POSTGRES_USER=auditor
POSTGRES_PASSWORD=securepassword123
POSTGRES_DB=finance_auditor
POSTGRES_PORT=5432
DATABASE_URL="postgresql://auditor:securepassword123@localhost:5432/finance_auditor?schema=public"

# NextAuth local development
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Google OAuth, required for Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ALLOWED_EMAIL=""

# Gemini, required only for document extraction
GEMINI_API_KEY=""

# Workspace defaults used to seed AppSetting on first local run.
DEFAULT_BASE_CURRENCY="MYR"
DEFAULT_DISPLAY_CURRENCIES="MYR,USD,LKR"
DEFAULT_TIMEZONE="Asia/Kuala_Lumpur"
DEFAULT_TRANSACTION_CATEGORIES="Salary,Food & Dining,Transport,Subscriptions,Rent,Health,Investments,Internal Transfer"
